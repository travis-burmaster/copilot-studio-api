{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DirectToEngineSettings": {
    "EnvironmentId": "your-environment-name", // e.g., "myorg"
    "BotIdentifier": "your-bot-identifier",
    "TenantId": "your-tenant-id", // e.g., "12345678-1234-1234-1234-123456789012"
    "AppClientId": "your-app-client-id", // e.g., "12345678-1234-1234-1234-123456789012"
    "Authority": "your-authority" // e.g., "https://login.microsoftonline.com/your-tenant-id"
  }
}